# ===== bjhc 公司知识库 · LLM 配置 =====
# 复制本文件为 .env 并填入真实值（不要把 .env 提交到版本库 / 共享出去）
#
# 系统使用 OpenAI 兼容接口，任选其一填入下面的 api_base / api_key / model：
#   1) DeepSeek : api_base=https://api.deepseek.com/v1     model=deepseek-chat
#   2) 通义千问 : api_base=https://dashscope.aliyuncs.com/compatible-mode/v1
#                 model=qwen-plus   （或 qwen-max / qwen-long）
#   3) OpenAI   : api_base=https://api.openai.com/v1      model=gpt-4o-mini
#   4) 本地 Ollama: api_base=http://localhost:11434/v1    model=llama3
#                 （数据不出内网，适合对保密要求高的制度资料）
#
# 不填 LLM_API_KEY 也能用：系统只返回检索到的资料片段，不做自然语言生成。

LLM_API_KEY=sk-xxxx
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
